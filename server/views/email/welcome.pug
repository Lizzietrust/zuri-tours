extends base

block content
  div.content
    p Hi #{firstName},
    
    p Welcome to Zuri Tours! 🎉 We're absolutely thrilled to have you join our community of explorers and adventure seekers.
    
    div.success-box
      strong ✅ Your account has been successfully created!
      p You can now start exploring amazing tours and creating unforgettable memories.
    
    div.info-box
      h3(style='margin-top: 0;') 🚀 Get Started with Zuri Tours:
      ul(style='padding-left: 20px;')
        li Browse our curated collection of tours
        li Book your first adventure
        li Earn reward points with every booking
        li Share your travel experiences
    
    div(style='text-align: center;')
      a.button(href=url) Start Exploring Now
    
    p Here are some popular tours to get you started:
    ul(style='padding-left: 20px;')
      li 🏔️ Mountain Trekking Adventures
      li 🌊 Coastal Paradise Getaways
      li 🏛️ Cultural Heritage Tours
      li 🌿 Eco-Friendly Nature Expeditions
    
    p We're here to help you every step of the way. If you have any questions, don't hesitate to reach out to our support team.
    
    hr
    
    p
      small You're receiving this email because you signed up for Zuri Tours. Welcome aboard!