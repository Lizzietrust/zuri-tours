extends base

block content
  div.content
    p Hi #{firstName},
    
    p You requested to reset your password for your Zuri Tours account. Click the button below to reset your password:
    
    div(style='text-align: center;')
      a.button(href=url) Reset Password
    
    div.warning-box
      strong ⚠️ Security Notice:
      p This password reset link will expire in 10 minutes.
      p If you didn't request a password reset, please ignore this email and your password will remain unchanged.
    
    p If the button above doesn't work, copy and paste this link into your browser:
    p(style='word-break: break-all; background-color: #f8f9fa; padding: 10px; border-radius: 5px;')
      a(href=url)= url
    
    hr
    
    p
      small This is an automated message. Please do not reply to this email.